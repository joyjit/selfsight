# selfsight environment — copy to .env (which is gitignored) and fill in.
#
# selfsight expands ${VAR} references in config.yaml from this environment, so
# your real secrets live here and config.yaml can stay secret-free (and
# committable). Name the variables however your config.yaml references them.

# Port the dashboard is published on (container always listens on 8080).
SELFSIGHT_PORT=8080

# The container runs as this uid:gid so it can write ./config and ./data.
# Set to the owner of those dirs (`id -u` / `id -g`); default 1000.
# SELFSIGHT_UID=1000
# SELFSIGHT_GID=1000

# --- device admin passwords (one per AP, matching your config.yaml refs) ---
# Example, if config.yaml has `password: ${LIVING_ROOM_PW}`:
# LIVING_ROOM_PW=your-ap-admin-password

# --- optional: password-protect the dashboard/API (server.auth) ---
# Referenced from config.yaml as ${SELFSIGHT_AUTH_PASSWORD}.
# SELFSIGHT_AUTH_PASSWORD=pick-something-strong
